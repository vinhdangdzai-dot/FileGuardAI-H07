# Reference only: run.py reads process environment, not this file automatically.
# Never put real keys in this example. Default feature is OFF until Admin opts in.
AI_EXPLANATION_PROVIDER=openai-compatible
AI_EXPLANATION_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_EXPLANATION_MODEL=
AI_EXPLANATION_API_KEY=
AI_EXPLANATION_TIMEOUT=3
AI_EXPLANATION_HOURLY_LIMIT=20

# Gemini: set PROVIDER=gemini and MODEL to an available model in your Google project.
# Uses fixed Google HTTPS endpoint; ENDPOINT above applies only to openai-compatible.
# Keep the same AI_EXPLANATION_API_KEY variable. Never commit real values.
# Gemini default timeout is 20s if TIMEOUT is unset (0.1..60s); max tokens 256..8192.
AI_EXPLANATION_MAX_TOKENS=2048

# Accounts: trusted public HTTPS base URL; never derive reset links from Host.
ACCOUNT_RESET_ORIGIN=
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
# 0 = mandatory STARTTLS; 1 = implicit TLS (normally port 465). No cleartext fallback.
ACCOUNT_SMTP_SSL=0
ACCOUNT_SMTP_FROM=
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
# Public HTTPS deployments: set COOKIE_SECURE=1 and a stable secret via environment.
# No real passwords, tokens, SMTP credentials or SECRET_KEY belong in this file.
SECRET_KEY=
COOKIE_SECURE=0
TRUST_PROXY=0

# MFA: a private JSON keyring independent of SECRET_KEY. Never commit its contents.
# Prefer a secret-manager/environment JSON keyring in production, or an external
# private file. Empty values use instance/mfa_keys.json for the localhost demo.
ACCOUNT_MFA_KEY_FILE=
ACCOUNT_MFA_KEYS=
