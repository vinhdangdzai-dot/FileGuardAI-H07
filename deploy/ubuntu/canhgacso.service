[Unit]
Description=CANH GAC SO Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/canhgacso
EnvironmentFile=/etc/canhgacso/canhgacso.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/deploy/apps/canhgacso/.venv/bin/gunicorn --worker-class gthread --workers 1 --threads 4 --bind 127.0.0.1:8000 --timeout 30 --graceful-timeout 30 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 --access-logfile - --error-logfile - --forwarded-allow-ips= "app:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/apps/canhgacso/instance
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
