# Copy to /etc/canhgacso/canhgacso.env with mode 0640, owner root:deploy.
# Never commit the populated file.
SECRET_KEY=
COOKIE_SECURE=1
TRUST_PROXY=1

# Optional recovery email. Keep blank to disable sending.
ACCOUNT_RESET_ORIGIN=https://canhgacso.fun
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_SSL=0
ACCOUNT_SMTP_FROM=
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=

# Optional Gemini explanations. The core LR IDS and path IPS work without these.
AI_EXPLANATION_PROVIDER=gemini-native
AI_EXPLANATION_MODEL=
AI_EXPLANATION_API_KEY=
AI_EXPLANATION_TIMEOUT=20
AI_EXPLANATION_HOURLY_LIMIT=20
AI_EXPLANATION_MAX_TOKENS=2048
